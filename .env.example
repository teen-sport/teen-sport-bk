# Copia este archivo como .env (no se versiona) y completa los valores.
# Formato de archivo de propiedades: CLAVE=valor, sin "export" ni comillas.
# Las variables de entorno del sistema tienen prioridad sobre este archivo.

# PostgreSQL 18.6. DB_PASSWORD es obligatoria.
DB_URL=jdbc:postgresql://localhost:5432/teen_sport
DB_USERNAME=teen_sport
DB_PASSWORD=

# Qué hace Hibernate con la estructura de la base al arrancar:
#   validate (por defecto): nunca crea ni modifica tablas; usar con bases compartidas o remotas.
#   update: crea y amplía tablas a partir de las entidades; solo para una base local de desarrollo.
DB_DDL_AUTO=validate

# Secreto HS256 de los JWT, mínimo 32 caracteres. Obligatorio.
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# Zona horaria de la academia para fechas de negocio (edad de los deportistas, periodos).
APP_TIME_ZONE=America/Bogota

# Orígenes del frontend autorizados por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Administrador inicial: se crea al arrancar si no existe ningún ADMIN.
# Defina las tres primeras o ninguna. La contraseña debe tener 8 a 72 caracteres
# con mayúscula, minúscula, número y símbolo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ID_NUMBER=
ADMIN_ID_TYPE=CC
ADMIN_FIRST_NAMES=Administrador
ADMIN_LAST_NAMES=TeenSport
